# restart sxhkd
super + shift + r
  pkill -usr1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# file explorer
super + e
  ghostty -e yazi

# browser
super + w
  librewolf -P personal

super + shift + w
  librewolf -P Work

super + {comma,period}
  mpc {prev,next}

super + p
  mpc toggle

super + shift + m
  ghostty -e ncmpcpp

# take screenshot of part of screen with selector
super + Print
  scrot -s - | xclip -selection clipboard -target image/png

# audio and volume
super + minus
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

super + underscore
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%-

super + equal
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

super + plus
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%+

XF86AudioMute
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

super + m
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioLowerVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioRaiseVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

shift + XF86AudioLowerVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%-

shift + XF86AudioRaiseVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%+

super + d
  rofi -show drun

# dwm
super + 1
  dwmc viewex 0 && eww update tag_poll=0

super + 2
  dwmc viewex 1 && eww update tag_poll=1

super + 3
  dwmc viewex 2 && eww update tag_poll=2

super + 4
  dwmc viewex 3 && eww update tag_poll=3

super + 5
  dwmc viewex 4 && eww update tag_poll=4

super + 6
  dwmc viewex 5 && eww update tag_poll=5

super + 7
  dwmc viewex 6 && eww update tag_poll=6

super + 8
  dwmc viewex 7 && eww update tag_poll=7

super + 9
  dwmc viewex 8 && eww update tag_poll=8
