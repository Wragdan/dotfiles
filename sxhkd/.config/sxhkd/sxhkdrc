# restart sxhkd
super + shift + r
  pkill -usr1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# change wallpaper
super + r ; c ; b
  shuf -e -n1 /home/wragdan/wallpapers/* | xargs feh --bg-scale

# file explorer
super + e
  st -e yazi

# browser
super + w
  librewolf -P personal

super + shift + w
  librewolf -P Work

super + {comma,period}
  mpc {prev,next}

super + p
  mpc toggle

super + shift + m
  st -e ncmpcpp

# take screenshot of part of screen with selector
super + Print
  scrot -s - | xclip -selection clipboard -target image/png

# audio and volume
super + minus
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

super + underscore
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%-

super + equal
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

super + plus
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%+

XF86AudioMute
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

super + m
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioLowerVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

XF86AudioRaiseVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+

shift + XF86AudioLowerVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%-

shift + XF86AudioRaiseVolume
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 15%+

super + d
  dmenu_run

