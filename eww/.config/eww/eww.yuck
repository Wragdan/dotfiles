; eww config

; ━━━━ windows ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :anchor "top center")
  :wm-ignore false
  (barw)
)

;(defwindow volume
;  :monitor 0
;  :windowtype "dock"
;  :geometry (geometry :x "0%"
;                      :y "0%"
;                      :width "100%"
;                      :anchor "top center")
;  :wm-ignore false
;  ()
;)

; ---- bars


(defwidget barw []
  (centerbox :class "barw" :orientation "h"
    (workspaces)
    (date)
    (sidestuff)
  )
)

; ---- widgets

(defpoll date_poll :interval "60m" "date +%d")
(defpoll time_poll :interval "1s" "date +%r")
(defpoll wlan_poll :interval "5s" "sb-wlan")
(defpoll volume_poll :interval "500ms" "sb-volume")
(defpoll tag_poll :interval "60s" "xprop -root _NET_CURRENT_DESKTOP | awk '{ print $3 }'")
(defpoll title :interval "1s" "mpc --format \"%title%\" current")
(defpoll artist :interval "1s" "mpc --format \"%artist%\" current")

(defwidget date []
  (box :class "widget date"
    :space-evenly false
    (label :class "icon" :text "󰃶")
    (label :text "${date_poll} - ${time_poll}")
  )
)

(defwidget wlan []
  (box :class "widget sidestuff-item wlan"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (button
        :onclick "st -e nmtui"
      (box
        (label :class "icon ${ (wlan_poll * 1) == 0 ? 'red' : '' }"
               :text "${  (wlan_poll * 1) > 80 ? '󰤨'
                        : (wlan_poll * 1) > 60 ? '󰤥'
                        : (wlan_poll * 1) > 40 ? '󰤢'
                        : (wlan_poll * 1) > 20 ? '󰤟'
                        : '󰤯'}")
        (label :text "${wlan_poll}%")
      )
    )
  )
)

(defwidget volume []
  (box :class "widget sidestuff-item volume"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :class "icon"
           :text "${  (volume_poll * 1) > 60 ? '󰕾'
                    : (volume_poll * 1) > 30 ? '󰖀'
                    : (volume_poll * 1) > 0 ? '󰕿'
                    : '󰝟'}")
    (label :visible {(volume_poll * 1) > 0} :text "${volume_poll}%")
  )
)

(defwidget ram []
  (box :class "widget sidestuff-item ram"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :class "icon" :text "󰍛")
    (label :text "${round(EWW_RAM.used_mem / (1024 * 1024 * 1024), 1)}G")
    (label :text " / ")
    (label :text "${round(EWW_RAM.total_mem / (1024 * 1024 * 1024), 1)}G")
  )
)

(defwidget battery []
  (box :class "widget sidestuff-item battery"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :visible {EWW_BATTERY["BAT0"].status == "Charging"} :class "icon" :text "󰂄" )
    (label :visible {EWW_BATTERY["BAT0"].status != "Charging"} :class "icon ${ EWW_BATTERY["BAT0"].capacity <= 20 ? 'critical' : '' }"
           :text "${  EWW_BATTERY["BAT0"].capacity > 95 ? '󰁹' 
                    : EWW_BATTERY["BAT0"].capacity > 90 ? '󰂂' 
                    : EWW_BATTERY["BAT0"].capacity > 80 ? '󰂁' 
                    : EWW_BATTERY["BAT0"].capacity > 70 ? '󰂀' 
                    : EWW_BATTERY["BAT0"].capacity > 60 ? '󰁿' 
                    : EWW_BATTERY["BAT0"].capacity > 50 ? '󰁾' 
                    : EWW_BATTERY["BAT0"].capacity > 40 ? '󰁽' 
                    : EWW_BATTERY["BAT0"].capacity > 30 ? '󰁼' 
                    : EWW_BATTERY["BAT0"].capacity > 20 ? '󰁻' 
                    : EWW_BATTERY["BAT0"].capacity > 10 ? '󰁺' 
                    : '󰂃' }")
    (label :text "${EWW_BATTERY["BAT0"].capacity}%")
  )
)

(defwidget nowplaying []
  (box :class "widget sidestuff-item ram"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :text "${artist} - ${title}")
  )
)

(defwidget sidestuff []
  (box :orientation "h"
       :halign "end"
       :space-evenly false
    (nowplaying)
    (volume)
    (battery)
    (ram)
    (wlan)
    ;(battery)
    ;(battery)
  )
)

(defwidget workspaces []
  (box :class "widget workspaces"
       :orientation "h"
       :space-evenly false
       :halign "start"
       :spacing 10
    (button :class "${(tag_poll * 1) == 0 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 0 && eww update tag_poll=0" 1)
    (button :class "${(tag_poll * 1) == 1 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 1 && eww update tag_poll=1" 2)
    (button :class "${(tag_poll * 1) == 2 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 2 && eww update tag_poll=2" 3)
    (button :class "${(tag_poll * 1) == 3 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 3 && eww update tag_poll=3" 4)
    (button :class "${(tag_poll * 1) == 4 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 4 && eww update tag_poll=4" 5)
    (button :class "${(tag_poll * 1) == 5 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 5 && eww update tag_poll=5" 6)
    (button :class "${(tag_poll * 1) == 6 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 6 && eww update tag_poll=6" 7)
    (button :class "${(tag_poll * 1) == 7 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 7 && eww update tag_poll=7" 8)
    (button :class "${(tag_poll * 1) == 8 ? 'selected-workspace' : '' }" :onclick "dwmc viewex 8 && eww update tag_poll=8" 9)
  )
)

