; eww config

; ━━━━ windows ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╸

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :anchor "top center")
  :wm-ignore false
  (barw)
)

; ---- bars


(defwidget barw []
  (centerbox :class "barw" :orientation "h"
    (workspaces)
    (date)
    (sidestuff)
  )
)

; ---- widgets

(defpoll date_poll :interval "60m" "date +%d")
(defpoll time_poll :interval "1s" "date +%r")
(defpoll wlan_poll :interval "5s" "sb-wlan")
(defpoll volume_poll :interval "500ms" "sb-volume")

(defwidget date []
  (box :class "widget date"
    :space-evenly false
    (label :class "icon" :text "󰃶")
    (label :text "${date_poll} - ${time_poll}")
  )
)

(defwidget wlan []
  (box :class "widget sidestuff-item wlan"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :class "icon ${ (wlan_poll * 1) == 0 ? 'red' : '' }"
           :text "${  (wlan_poll * 1) > 80 ? '󰤨'
                    : (wlan_poll * 1) > 60 ? '󰤥'
                    : (wlan_poll * 1) > 40 ? '󰤢'
                    : (wlan_poll * 1) > 20 ? '󰤟'
                    : '󰤯'}")
    (label :text "${wlan_poll}%")
  )
)

(defwidget volume []
  (box :class "widget sidestuff-item volume"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :class "icon"
           :text "${  (volume_poll * 1) > 60 ? '󰕾'
                    : (volume_poll * 1) > 30 ? '󰖀'
                    : (volume_poll * 1) > 0 ? '󰕿'
                    : '󰝟'}")
    (label :visible {(volume_poll * 1) > 0} :text "${volume_poll}%")
  )
)

(defwidget ram []
  (box :class "widget sidestuff-item ram"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :class "icon" :text "󰍛")
    (label :text "${round(EWW_RAM.used_mem / (1024 * 1024 * 1024), 1)}G")
    (label :text " / ")
    (label :text "${round(EWW_RAM.total_mem / (1024 * 1024 * 1024), 1)}G")
  )
)

(defwidget battery []
  (box :class "widget sidestuff-item battery"
       :orientation "h"
       :space-evenly false
       :halign "end"
    (label :visible {EWW_BATTERY["BAT0"].status == "Charging"} :class "icon" :text "󰂄" )
    (label :visible {EWW_BATTERY["BAT0"].status != "Charging"} :class "icon ${ EWW_BATTERY["BAT0"].capacity <= 20 ? 'critical' : '' }"
           :text "${  EWW_BATTERY["BAT0"].capacity > 95 ? '󰁹' 
                    : EWW_BATTERY["BAT0"].capacity > 90 ? '󰂂' 
                    : EWW_BATTERY["BAT0"].capacity > 80 ? '󰂁' 
                    : EWW_BATTERY["BAT0"].capacity > 70 ? '󰂀' 
                    : EWW_BATTERY["BAT0"].capacity > 60 ? '󰁿' 
                    : EWW_BATTERY["BAT0"].capacity > 50 ? '󰁾' 
                    : EWW_BATTERY["BAT0"].capacity > 40 ? '󰁽' 
                    : EWW_BATTERY["BAT0"].capacity > 30 ? '󰁼' 
                    : EWW_BATTERY["BAT0"].capacity > 20 ? '󰁻' 
                    : EWW_BATTERY["BAT0"].capacity > 10 ? '󰁺' 
                    : '󰂃' }")
    (label :text "${EWW_BATTERY["BAT0"].capacity}%")
  )
)


(defwidget sidestuff []
  (box :orientation "h"
       :halign "end"
       :space-evenly false
    (volume)
    (battery)
    (ram)
    (wlan)
    ;(battery)
    ;(battery)
  )
)

(defwidget workspaces []
  (box :class "widget workspaces"
       :orientation "h"
       :space-evenly false
       :halign "start"
       :spacing 10
    (button :onclick "dwmc view 0" 1)
    (button :onclick "dwmc view 1" 2)
    (button :onclick "dwmc view 2" 3)
    (button :onclick "dwmc view 3" 4)
    (button :onclick "dwmc view 4" 5)
    (button :onclick "dwmc view 5" 6)
    (button :onclick "dwmc view 6" 7)
    (button :onclick "dwmc view 7" 8)
    (button :onclick "dwmc view 8" 9)
  )
)

